# LLM
ANTHROPIC_API_KEY=sk-ant-...

# Meta Graph API (Instagram 자동 업로드)
# 발급 절차는 README 참고. 시스템 사용자 토큰(무기한) 권장.
META_ACCESS_TOKEN=EAA...                # 시스템 사용자 토큰 (무기한)
IG_USER_ID=17841xxxxxxxxxxxx            # Instagram Business Account ID

# 이미지 호스팅 - Cloudinary
# https://cloudinary.com → 콘솔 우상단 "API Environment variable" 그대로 복붙
# scheduler.py 가 approved/ PNG를 cardnews/<date>/<slot>/<NN> 으로 업로드
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# (선택) 실패 알림용 - 슬랙 webhook 등
NOTIFY_WEBHOOK_URL=

# (선택) 댓글 키워드 → DM 자동응답. 없으면 등록만 skip, 발행은 정상 진행.
# ig-webhook/README.md 로 Cloudflare Worker 배포 후 채운다.
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=
