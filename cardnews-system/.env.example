# LLM
ANTHROPIC_API_KEY=sk-ant-...

# Meta Graph API (Instagram 자동 업로드)
# https://developers.facebook.com  →  앱 생성  →  instagram_content_publish 권한
META_ACCESS_TOKEN=EAA...                # 장기 토큰 (60일)
IG_USER_ID=1789xxxxxxxxxxxx             # Instagram Business Account ID

# 업로드 시 PNG들이 외부에서 접근 가능해야 함 (Meta가 URL로 fetch).
# scheduler.py 가 발행 직전 Cloudinary 에 업로드해 secure_url 을 image_url 로 사용.
# Cloudinary 콘솔 → Dashboard → "API Environment variable" 값을 그대로 붙여넣기:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://123456789012345:abcdEFGH_ijklMNOP-qrstUVWXyz0@my-cloud

# (선택) 실패 알림용 - 슬랙 webhook 등
NOTIFY_WEBHOOK_URL=
